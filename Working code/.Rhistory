metadatapgr$sample=metadatapgr$old_ID
pgrfunclong = merge(pbarfunclong, metadatapgr[,c(3,8)], all.x = TRUE)
View(pgrfunclong)
Pbarpgr = pgrfunclong %>%
+ group_by(PGR, Irrigation)%>%summarise(Csum= sum(reads))
