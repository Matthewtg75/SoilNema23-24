+ group_by("PGR", "Irrigation")%>%summarise(Csum= sum(reads))
Pbarpgr = pgrfunclong %>%
group_by(PGR, Irrigation)%>%summarise(Csum= sum(reads))
Pbarpgr$rf=(Pbarpgr$Csum/sum(Pbarpgr$Csum))*100
Pbarpgr= Pbarpgr%>%
+ group_by(Irrigation)%>%
+ mutate(rf=(Csum/sum(Csum))*100)
